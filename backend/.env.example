# AI Provider
OPENAI_API_KEY=sk-xxx
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# Local Whisper (fallback when API provider doesn't support /v1/audio/transcriptions)
# Can be a model size name (tiny, base, small, medium, large-v3) or an absolute path.
# Size names are auto-downloaded to /app/models/faster-whisper-<size> on first run.
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=auto
LOCAL_WHISPER_COMPUTE_TYPE=auto

# Subtitles
BILIBILI_SESSION_TOKEN=
SAVESUBS_X_AUTH_TOKEN=

# Cache (choose one)
REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# !!! Hugging Face token - optional but IMPORTANT !!!
# speeds up model downloads and avoids rate limits
# access https://huggingface.co/settings/tokens to aquire free token
HF_TOKEN=

# Server
BACKEND_PORT=8000

# CORS
FRONTEND_URL=http://localhost:3000
